# create a directory and cd into it
function mkcd() {
  mkdir -p "$@" && cd "$_";
}

# Kill process running on specified port
function killport() {
  if [ $# -eq 0 ]; then
    echo "Usage: killport <port_number>"
    return 1
  fi
  
  local port=$1
  local pid=$(lsof -t -i:"$port")
  
  if [ -z "$pid" ]; then
    echo "No process found running on port $port"
    return 1
  fi
  
  echo "Found process(es) using port $port:"
  lsof -i:"$port" | grep LISTEN
  
  echo "Killing process(es)..."
  kill -9 $pid
  
  echo "Process(es) on port $port killed successfully"
}

# Determine size of a file or total size of a directory
function fs() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh;
	else
		local arg=-sh;
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@";
	else
		du $arg .[^.]* ./*;
	fi;
}

# Normalize `open` across Linux, macOS, and Windows.
# This is needed to make the `o` function (see below) cross-platform.
if [ ! $(uname -s) = 'Darwin' ]; then
	if grep -q Microsoft /proc/version; then
		# Ubuntu on Windows using the Linux subsystem
		alias open='explorer.exe';
	else
		alias open='xdg-open';
	fi
fi

# `o` with no arguments opens the current directory, otherwise opens the given
# location
function o() {
	if [ $# -eq 0 ]; then
		open .;
	else
		open "$@";
	fi;
}

# create a new branch and pull from main
function gnb() { 
	git checkout -b "$1" && git pull origin main; 
};

# Delete all node_modules directories in current path and subdirectories
function rmnodemodules() {
	echo "Searching for node_modules directories..."
	local count=0
	
	# Find all node_modules directories and delete them (excluding nested ones)
	while IFS= read -r -d '' dir; do
		# Skip if this node_modules is inside another node_modules directory
		if [[ "$dir" == *"/node_modules/"* ]]; then
			continue
		fi
		
		echo "Deleting: $dir"
		rm -rf "$dir"
		((count++))
	done < <(find . -name "node_modules" -type d -print0)
	
	if [ $count -eq 0 ]; then
		echo "No node_modules directories found"
	else
		echo "Deleted $count node_modules directory(ies)"
	fi
}
